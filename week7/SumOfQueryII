//Sum of Query II-GFG

class Solution {
    List<Integer> querySum(int n, int arr[], int q, int queries[]) {
        // code here
        List<Integer> res = new ArrayList<>();
        int prefix[] = new int[n+1];
        prefix[0]=0;
        for(int i=1;i<=n;i++){
            prefix[i]=prefix[i-1]+arr[i-1];
        }
        int idx=0;
        for(int i=0;i<q;i++){
            int l = queries[idx++];
            int r = queries[idx++];
            
            int sum= prefix[r]-prefix[l-1];
            res.add(sum);
        }
        return res;
        
        
    }
}